          "validation_pattern": "^[A-Z0-9]{10}$"
        },
        {
          "field_code": "cup_code",
          "label": "Codice CUP",
          "value_type": "identifier",
          "required": false,
          "review_threshold": 0.85,
          "normalization_rules": [
            "strip",
            "alphanumeric"
          ],
          "validation_pattern": "^[A-Z0-9]{15}$"
        },
        {
          "field_code": "iban",
          "label": "IBAN accredito",
          "value_type": "identifier",
          "required": false,
          "review_threshold": 0.85,
          "normalization_rules": [
            "strip",
            "iban"
          ],
          "validation_pattern": "^[A-Z]{2}\\d{2}[A-Z0-9]{11,30}$"
        }
      ]
    },
    {
