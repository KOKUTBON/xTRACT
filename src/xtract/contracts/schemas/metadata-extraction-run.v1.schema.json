{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xtract.dev/schemas/metadata-extraction-run.v1.schema.json",
  "title": "Metadata Extraction Run v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "document_id",
    "processing_status",
    "source_ocr_output_path",
    "document_family",
    "document_type_candidate",
    "field_results",
    "needs_human_review",
    "extracted_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "run_id": {
      "type": "string",
      "format": "uuid"
    },
    "document_id": {
      "type": "string",
      "format": "uuid"
    },
    "processing_status": {
      "type": "string",
      "enum": [
        "success",
        "duplicate",
        "rejected",
        "failed"
      ]
    },
    "source_ocr_output_path": {
      "type": "string"
    },
    "document_family": {
      "type": "string"
    },
    "document_type_candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type_code",
        "display_name",
        "family_code",
        "taxonomy_version",
        "selection_source",
        "confidence_score",
        "is_final"
      ],
      "properties": {
        "type_code": {
          "type": "string"
        },
        "display_name": {
          "type": "string"
        },
        "family_code": {
          "type": "string"
        },
        "taxonomy_version": {
          "type": "string"
        },
        "selection_source": {
          "type": "string",
          "enum": [
            "operator",
            "system_rule",
            "model",
            "external_system"
          ]
        },
        "confidence_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "is_final": {
          "type": "boolean"
        }
      }
    },
    "field_results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "field_code",
          "label",
          "value_type",
          "required",
          "raw_value",
          "normalized_value",
          "confidence_score",
          "review_required",
          "review_reason_codes",
          "strategy_trace"
        ],
        "properties": {
          "field_code": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "value_type": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          },
          "raw_value": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          },
          "normalized_value": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          },
          "display_value": {
            "type": [
              "string",
              "null"
            ]
          },
          "null_reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "confidence_score": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "review_required": {
            "type": "boolean"
          },
          "review_reason_codes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "matched_alias_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "uniqueItems": true
          },
          "source_page_number": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "source_bounding_box": {
            "type": [
              "object",
              "null"
            ]
          },
          "strategy_trace": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "strategy_id",
                "source_kind",
                "status",
                "contribution"
              ],
              "properties": {
                "strategy_id": {
                  "type": "string"
                },
                "source_kind": {
                  "type": "string"
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "matched",
                    "not_matched",
                    "not_run",
                    "validation_penalty"
                  ]
                },
                "contribution": {
                  "type": "number",
                  "minimum": -1,
                  "maximum": 1
                },
                "note": {
                  "type": "string"
                }
              }
            }
          },
          "source_text": {
            "type": [
              "string",
              "null"
            ],
            "description": "OCR line that anchored the value."
          }
        }
      }
    },
    "needs_human_review": {
      "type": "boolean"
    },
    "extracted_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
