{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xtract.dev/schemas/delivery-report.v1.schema.json",
  "title": "Delivery Report v1",
  "description": "Delivery attempts and final outcomes for one integration-hub run.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "connector_id",
    "generated_at",
    "deliveries",
    "summary"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "run_id": {
      "type": "string",
      "format": "uuid"
    },
    "connector_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "deliveries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Delivery"
      }
    },
    "summary": {
      "$ref": "#/$defs/Summary"
    }
  },
  "$defs": {
    "Attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempt_number",
        "started_at",
        "completed_at",
        "result",
        "audit_correlation_id"
      ],
      "properties": {
        "attempt_number": {
          "type": "integer",
          "minimum": 1
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "completed_at": {
          "type": "string",
          "format": "date-time"
        },
        "result": {
          "type": "string",
          "enum": [
            "success",
            "retryable_failure",
            "permanent_failure",
            "skipped"
          ]
        },
        "error_code": {
          "type": [
            "string",
            "null"
          ]
        },
        "http_status": {
          "type": [
            "integer",
            "null"
          ]
        },
        "audit_correlation_id": {
          "type": "string",
          "format": "uuid"
        },
        "remote_reference_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "Delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_id",
        "command_id",
        "final_status",
        "attempts"
      ],
      "properties": {
        "document_id": {
          "type": "string",
          "format": "uuid"
        },
        "command_id": {
          "type": "string",
          "format": "uuid"
        },
        "final_status": {
          "type": "string",
          "enum": [
            "synchronized",
            "failed",
            "skipped"
          ]
        },
        "skip_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "attempts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/Attempt"
          }
        },
        "response_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "updated_document_path": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "Summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "synchronized_count",
        "failed_count",
        "skipped_count"
      ],
      "properties": {
        "synchronized_count": {
          "type": "integer",
          "minimum": 0
        },
        "failed_count": {
          "type": "integer",
          "minimum": 0
        },
        "skipped_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
