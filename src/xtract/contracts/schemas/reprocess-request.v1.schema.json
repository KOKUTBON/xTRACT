{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xtract.dev/schemas/reprocess-request.v1.schema.json",
  "title": "Reprocess Request v1",
  "description": "Governed manual request to re-run part of the document pipeline.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "document_id",
    "scope",
    "requested_by",
    "requested_at",
    "reason_code",
    "status"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "request_id": {
      "type": "string",
      "format": "uuid"
    },
    "document_id": {
      "type": "string",
      "format": "uuid"
    },
    "scope": {
      "type": "string",
      "enum": [
        "ocr",
        "extraction",
        "integration"
      ]
    },
    "requested_by": {
      "type": "string"
    },
    "requested_at": {
      "type": "string",
      "format": "date-time"
    },
    "reason_code": {
      "type": "string"
    },
    "comment": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "requested",
        "accepted",
        "completed",
        "rejected"
      ]
    },
    "target_route_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "related_exception_id": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
