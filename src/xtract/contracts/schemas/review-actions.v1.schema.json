{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xtract.dev/schemas/review-actions.v1.schema.json",
  "title": "Review Actions v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "actions"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "document_id",
          "field_code",
          "decision",
          "reviewer_id",
          "reviewed_at",
          "accepted_for_learning"
        ],
        "properties": {
          "document_id": {
            "type": "string",
            "format": "uuid"
          },
          "field_code": {
            "type": "string"
          },
          "decision": {
            "type": "string",
            "enum": [
              "accepted",
              "corrected",
              "rejected",
              "escalated"
            ]
          },
          "reviewer_id": {
            "type": "string"
          },
          "reviewed_at": {
            "type": "string",
            "format": "date-time"
          },
          "corrected_value": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          },
          "comment": {
            "type": "string"
          },
          "accepted_for_learning": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
