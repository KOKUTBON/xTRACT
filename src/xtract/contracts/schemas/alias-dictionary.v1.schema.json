{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xtract.dev/schemas/alias-dictionary.v1.schema.json",
  "title": "Alias Dictionary v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "aliases"
  ],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "aliases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "alias_id",
          "document_family",
          "document_type",
          "field_code",
          "alias_text",
          "match_strategy",
          "scope",
          "active",
          "extraction_weight"
        ],
        "properties": {
          "alias_id": {
            "type": "string",
            "format": "uuid"
          },
          "institution_id": {
            "type": "string"
          },
          "office_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "document_family": {
            "type": "string"
          },
          "document_type": {
            "type": "string"
          },
          "field_code": {
            "type": "string"
          },
          "alias_text": {
            "type": "string"
          },
          "match_strategy": {
            "type": "string",
            "enum": [
              "exact",
              "normalized",
              "regex",
              "fuzzy",
              "semantic"
            ]
          },
          "scope": {
            "type": "string",
            "enum": [
              "global",
              "tenant",
              "document_type",
              "office"
            ]
          },
          "active": {
            "type": "boolean"
          },
          "value_regex": {
            "type": [
              "string",
              "null"
            ]
          },
          "extraction_weight": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  }
}
