{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xtract.dev/schemas/exception-inbox.v1.schema.json",
  "title": "Exception Inbox v1",
  "description": "Visible exception queue for operator and supervisor handling.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "items",
    "summary"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ExceptionItem"
      }
    },
    "summary": {
      "$ref": "#/$defs/Summary"
    }
  },
  "$defs": {
    "ExceptionItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exception_id",
        "document_id",
        "institution_id",
        "stage_id",
        "exception_code",
        "category",
        "severity",
        "status",
        "source_system",
        "message",
        "recommended_action",
        "allowed_actions",
        "opened_at"
      ],
      "properties": {
        "exception_id": {
          "type": "string"
        },
        "document_id": {
          "type": "string",
          "format": "uuid"
        },
        "institution_id": {
          "type": "string"
        },
        "stage_id": {
          "type": "string"
        },
        "exception_code": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "severity": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "open",
            "resolved"
          ]
        },
        "source_system": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "recommended_action": {
          "type": "string"
        },
        "allowed_actions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "opened_at": {
          "type": "string",
          "format": "date-time"
        },
        "resolved_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "audit_event_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "Summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_items",
        "open_items",
        "resolved_items"
      ],
      "properties": {
        "total_items": {
          "type": "integer",
          "minimum": 0
        },
        "open_items": {
          "type": "integer",
          "minimum": 0
        },
        "resolved_items": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
