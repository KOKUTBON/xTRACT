{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xtract.dev/schemas/field-taxonomy.v1.schema.json",
  "title": "Field Taxonomy v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "document_types"
  ],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "document_types": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type_code",
          "display_name",
          "family_code",
          "taxonomy_version",
          "fields"
        ],
        "properties": {
          "type_code": {
            "type": "string"
          },
          "display_name": {
            "type": "string"
          },
          "family_code": {
            "type": "string"
          },
          "taxonomy_version": {
            "type": "string"
          },
          "institution_id": {
            "type": "string"
          },
          "fields": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "field_code",
                "label",
                "value_type",
                "required",
                "review_threshold",
                "normalization_rules"
              ],
              "properties": {
                "field_code": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                },
                "value_type": {
                  "type": "string",
                  "enum": [
                    "string",
                    "text",
                    "date",
                    "integer",
                    "decimal",
                    "boolean",
                    "identifier",
                    "code"
                  ]
                },
                "required": {
                  "type": "boolean"
                },
                "review_threshold": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "validation_pattern": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "normalization_rules": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "strip",
                      "collapse_whitespace",
                      "title_case",
                      "uppercase",
                      "digits_only",
                      "date_iso",
                      "decimal",
                      "fiscal_code",
                      "iban",
                      "vat_number",
                      "alphanumeric"
                    ]
                  },
                  "uniqueItems": true
                }
              }
            }
          }
        }
      }
    }
  }
}
