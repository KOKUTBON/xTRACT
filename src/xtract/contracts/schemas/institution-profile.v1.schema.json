{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xtract.dev/schemas/institution-profile.v1.schema.json",
  "title": "Institution Profile v1",
  "description": "White-label institution identity, theme, and localization configuration.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "institution_id",
    "institution_name",
    "app_title",
    "logo_url",
    "accent_color",
    "default_locale",
    "supported_locales"
  ],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "institution_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_.-]+$"
    },
    "institution_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "app_title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "tagline": {
      "type": "string",
      "maxLength": 240
    },
    "logo_url": {
      "type": "string",
      "minLength": 1
    },
    "logo_dark_url": {
      "type": "string"
    },
    "app_icon_url": {
      "type": "string"
    },
    "favicon_url": {
      "type": "string"
    },
    "accent_color": {
      "type": "string",
      "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$"
    },
    "accent_color_dark": {
      "type": "string",
      "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$"
    },
    "country_code": {
      "type": "string",
      "pattern": "^[A-Z]{2}$"
    },
    "default_locale": {
      "type": "string",
      "pattern": "^[a-z]{2}(-[A-Z]{2})?$"
    },
    "supported_locales": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z]{2}(-[A-Z]{2})?$"
      }
    },
    "contact_email": {
      "type": "string"
    }
  }
}
