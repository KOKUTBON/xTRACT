# ==============================================================================
# xTRACT Environment Configuration Template
# ==============================================================================
# Copy this template to .env (or configure your shell / container environment)
# and set appropriate values for your deployment.
#
# Defaults work out-of-the-box for local development on http://127.0.0.1:8000.
# No secrets, real credentials, or private keys should ever be committed.
# ==============================================================================

# ------------------------------------------------------------------------------
# Server & Network Binding
# ------------------------------------------------------------------------------
# Host interface to bind (127.0.0.1 for local access, 0.0.0.0 for containerized deployment)
XTRACT_HOST=127.0.0.1
# Port to listen on
XTRACT_PORT=8000

# ------------------------------------------------------------------------------
# Security & Authentication
# ------------------------------------------------------------------------------
# Shared API bearer token for authentication.
# When configured, all endpoints under /api/ (except /api/v1/health) mandate:
#   Authorization: Bearer <your-secret-token>
# Leave empty for single-user local development without authentication.
XTRACT_API_TOKEN=

# Authentication mode: auto, none, token, jwt, oidc, or header.
# auto permits anonymous local use only when no credentials or federation are configured.
# Protected modes reject missing credentials, even if configuration is incomplete.
XTRACT_AUTH_MODE=auto
# Set a private signing key to validate and issue HS256 JWTs (no built-in secret).
# When empty, a configured XTRACT_API_TOKEN is used as the signing key.
XTRACT_JWT_SECRET=
# Optional expected JWT issuer and audience
XTRACT_JWT_ISSUER=
XTRACT_JWT_AUDIENCE=
# Enable only behind a trusted authentication proxy that strips client-supplied
# identity headers. Prevent direct access to the application server.
XTRACT_TRUST_FORWARDED_HEADERS=false

# Allowed CORS origins (comma-separated list, e.g. http://localhost:3000,https://portal.example.org)
# Leave empty to restrict to same-origin requests.
XTRACT_CORS_ORIGINS=

# ------------------------------------------------------------------------------
# Storage & Persistence
# ------------------------------------------------------------------------------
# Root directory for private application runtime data (SQLite database, file blobs)
XTRACT_DATA_DIR=./data

# Explicit database path override (defaults to $XTRACT_DATA_DIR/xtract.db)
# XTRACT_DATABASE_PATH=./data/xtract.db

# Explicit blob storage path override (defaults to $XTRACT_DATA_DIR/storage)
# XTRACT_STORAGE_ROOT=./data/storage

# ------------------------------------------------------------------------------
# Configuration & Policies
# ------------------------------------------------------------------------------
# Directory containing extraction policies, taxonomies, and connector catalogs
XTRACT_CONFIG_DIR=./config

# ------------------------------------------------------------------------------
# Intake & Document Ingestion Defaults
# ------------------------------------------------------------------------------
# Default namespace for document ingestion
XTRACT_DEFAULT_INSTITUTION=default
# Default office identifier
XTRACT_DEFAULT_OFFICE=general
# Maximum upload payload size in bytes (default: 52428800 = 50 MB)
XTRACT_MAX_UPLOAD_BYTES=52428800
# Reject duplicate files per institution based on SHA-256 hash (true / false)
XTRACT_REJECT_DUPLICATES=true

# ------------------------------------------------------------------------------
# Background Processing Worker
# ------------------------------------------------------------------------------
# Run asynchronous background worker thread alongside HTTP server (true / false)
XTRACT_WORKER_ENABLED=true
# Polling interval in seconds when checking the job queue
XTRACT_WORKER_POLL_SECONDS=1.0

# ------------------------------------------------------------------------------
# OCR Engine Configuration
# ------------------------------------------------------------------------------
# Installed Tesseract language code(s) (e.g. eng, ita, eng+ita, deu, fra, spa)
XTRACT_TESSERACT_LANG=eng
# Maximum execution time per scanned page in seconds before aborting
XTRACT_OCR_PAGE_TIMEOUT=120.0
# Total document OCR deadline in seconds before aborting
XTRACT_OCR_TOTAL_TIMEOUT=600.0
